package streamAPIMap;
import java.util.*;
import java.util.stream.Collectors;

public class PracticeSetMap {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
        List<String> names = Arrays.asList("ankit", "rahul", "amit");
        List<String> result = names.stream()
         .map(String::toUpperCase)
        .collect(Collectors.toList());
        System.out.println(result);
        
        // Square
        
        List<Integer> list = Arrays.asList(1, 2, 3, 4);
        List<Integer> result1=list.stream()
        .map(n -> n * n)
        .collect(Collectors.toList());
        System.out.println(result1);
        
        //Starts with "A"
        
        List<String> list1= Arrays.asList("Java", "Python", "C");
        List<Character> result2=list1.stream()
          .map(s -> s.charAt(0))
         .collect(Collectors.toList());
        System.out.println(result2);

        // String length
        List<String> list3= Arrays.asList("Java", "Stream", "API");
        List<Integer> result3= list3.stream()
        .map(String::length)
         .collect(Collectors.toList());
        System.out.println(result3);
        
        class Employee {
            String name;
            Employee(String name) { 
            	this.name = name; 
            	}
        }

        List<Employee> list4= Arrays.asList(new Employee("Amit"),new Employee("Rahul"));

        List<String> result4= list4.stream()
        .map(emp -> emp.name)
       .collect(Collectors.toList());
        System.out.println(result4);

	}

}
